  "sentences": [
    {
      "id": "s1",
      "text": "En Europe, on parle plus de 200 langues.",
      "zh": "欧洲使用的语言超过200种。",
      "glosses": [
        {
          "surface": "parle",
          "lemma": "parler",
          "zh": "说；使用（语言）",
          "note": "动词，现在时",
          "start": 14,
          "end": 19
        }
      ]
    },
    {
      "id": "s2",
      "text": "L’Union européenne a 24 langues officielles.",
      "zh": "欧盟有24种官方语言。",
      "glosses": [
        {
          "surface": "officielles",
          "lemma": "officiel",
          "zh": "官方的",
          "note": "形容词，阴性复数",
          "start": 32,
          "end": 43
        }
      ]
    },
    {
      "id": "s3",
      "text": "Elle compte aussi plus de 60 langues régionales ou minoritaires.",
      "zh": "欧盟还有60多种地区语言或少数群体语言。",
      "glosses": [
        {
          "surface": "compte",
          "lemma": "compter",
          "zh": "有；包含",
          "note": "动词，现在时",
          "start": 5,
          "end": 11
        }
      ]
    },
    {
      "id": "s4",
      "text": "Le 26 septembre est la Journée européenne des langues.",
      "zh": "9月26日是欧洲语言日。",
      "glosses": []
    },
    {
      "id": "s5",
      "text": "Cette journée existe depuis 2001.",
      "zh": "这个纪念日始于2001年。",
      "glosses": [
        {
          "surface": "depuis",
          "lemma": "depuis",
          "zh": "自……以来",
          "note": "介词",
          "start": 21,
          "end": 27
        }
      ]
    },
    {
      "id": "s6",
      "text": "On la célèbre aussi en dehors de l’Union européenne.",
      "zh": "人们在欧盟以外的地方也庆祝这一纪念日。",
      "glosses": [
        {
          "surface": "célèbre",
          "lemma": "célébrer",
          "zh": "庆祝",
          "note": "动词，现在时",
          "start": 6,
          "end": 13
        }
      ]
    },
    {
      "id": "s7",
      "text": "Dans un article du 26 septembre 2026, la Commission européenne parle des langues et de leurs avantages.",
      "zh": "在2026年9月26日的一篇文章中，欧盟委员会谈到了语言及其益处。",
      "glosses": [
        {
          "surface": "parle",
          "lemma": "parler",
          "zh": "谈到；谈论",
          "note": "动词，现在时",
          "start": 63,
          "end": 68
        },
        {
          "surface": "avantages",
          "lemma": "avantage",
          "zh": "益处",
          "note": "名词，阳性复数",
          "start": 93,
          "end": 102
        }
      ]
    },
    {
      "id": "s8",
      "text": "Pour elle, apprendre des langues aide à découvrir d’autres cultures.",
      "zh": "在委员会看来，学习语言有助于了解其他文化。",
      "glosses": [
        {
          "surface": "apprendre",
          "lemma": "apprendre",
          "zh": "学习",
          "note": "动词",
          "start": 11,
          "end": 20
        },
        {
          "surface": "découvrir",
          "lemma": "découvrir",
          "zh": "了解；发现",
          "note": "动词",
          "start": 40,
          "end": 49
        }
      ]
    },
    {
      "id": "s9",
      "text": "Cela aide aussi à créer des liens entre les personnes.",
      "zh": "这也有助于在人们之间建立联系。",
      "glosses": [
        {
          "surface": "liens",
          "lemma": "lien",
          "zh": "联系",
          "note": "名词，阳性复数",
          "start": 28,
          "end": 33
        }
      ]
    },
    {
      "id": "s10",
      "text": "Parler plusieurs langues peut offrir de nouvelles possibilités de travail.",
      "zh": "掌握多种语言可能带来新的工作机会。",
      "glosses": []
    },
    {
      "id": "s11",
      "text": "En 2026, le thème de cette journée met en avant les langues qui nous unissent.",
      "zh": "2026年，这一纪念日的主题强调语言将我们联系起来。",
      "glosses": [
        {
          "surface": "unissent",
          "lemma": "unir",
          "zh": "将……联系起来",
          "note": "动词，现在时第三人称复数",
          "start": 69,
          "end": 77
        }
      ]
    }
  ]
