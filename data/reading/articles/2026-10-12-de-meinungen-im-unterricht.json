  "sentences": [
    {
      "id": "s1",
      "text": "Was bedeutet Neutralität in der Schule?",
      "zh": "学校里的中立意味着什么？",
      "glosses": [
        {
          "surface": "bedeutet",
          "lemma": "bedeuten",
          "zh": "意味着"
        },
        {
          "surface": "Neutralität",
          "lemma": "die Neutralität",
          "zh": "中立"
        }
      ]
    },
    {
      "id": "s2",
      "text": "Ein Artikel der Bundeszentrale für politische Bildung erklärt wichtige Regeln für den Unterricht.",
      "zh": "德国联邦政治教育中心的一篇文章解释了课堂教学中的重要规则。",
      "glosses": [
        {
          "surface": "Artikel",
          "lemma": "der Artikel",
          "zh": "文章"
        },
        {
          "surface": "Bundeszentrale für politische Bildung",
          "lemma": "die Bundeszentrale für politische Bildung",
          "zh": "德国联邦政治教育中心",
          "note": "机构名称，简称 bpb"
        },
        {
          "surface": "Regeln",
          "lemma": "die Regel",
          "zh": "规则",
          "note": "复数"
        },
        {
          "surface": "Unterricht",
          "lemma": "der Unterricht",
          "zh": "课堂教学"
        }
      ]
    },
    {
      "id": "s3",
      "text": "Lehrerinnen und Lehrer dürfen ihre eigene Meinung sagen.",
      "zh": "教师可以表达自己的意见。",
      "glosses": [
        {
          "surface": "dürfen",
          "lemma": "dürfen",
          "zh": "可以；获准",
          "note": "情态动词，句末接原形 sagen"
        },
        {
          "surface": "eigene",
          "lemma": "eigen",
          "zh": "自己的"
        },
        {
          "surface": "Meinung",
          "lemma": "die Meinung",
          "zh": "意见；观点"
        }
      ]
    },
    {
      "id": "s4",
      "text": "Dabei muss klar sein: Das ist ihre persönliche Meinung.",
      "zh": "同时必须明确：这是他们个人的意见。",
      "glosses": [
        {
          "surface": "Dabei",
          "lemma": "dabei",
          "zh": "在这样做时；同时"
        },
        {
          "surface": "klar",
          "lemma": "klar",
          "zh": "明确的"
        },
        {
          "surface": "persönliche",
          "lemma": "persönlich",
          "zh": "个人的"
        }
      ]
    },
    {
      "id": "s5",
      "text": "Sie dürfen den Schülerinnen und Schülern ihre Meinung nicht aufdrängen.",
      "zh": "他们不能把自己的意见强加给学生。",
      "glosses": [
        {
          "surface": "Schülerinnen",
          "lemma": "die Schülerin",
          "zh": "女学生",
          "note": "复数第三格；与 Schülern 并列泛指学生"
        },
        {
          "surface": "Schülern",
          "lemma": "der Schüler",
          "zh": "学生；男学生",
          "note": "复数第三格，多了词尾 -n"
        },
        {
          "surface": "aufdrängen",
          "lemma": "aufdrängen",
          "zh": "强加",
          "note": "jemandem etwas aufdrängen：把某事强加给某人"
        }
      ]
    },
    {
      "id": "s6",
      "text": "Auch in einem Klassenchat gelten diese Regeln.",
      "zh": "这些规则在班级群聊中也适用。",
      "glosses": [
        {
          "surface": "Klassenchat",
          "lemma": "der Klassenchat",
          "zh": "班级群聊"
        },
        {
          "surface": "gelten",
          "lemma": "gelten",
          "zh": "适用；有效"
        }
      ]
    },
    {
      "id": "s7",
      "text": "Wenn ein Thema in Politik oder Wissenschaft umstritten ist, sollen auch im Unterricht verschiedene Positionen dazu vorkommen.",
      "zh": "如果一个话题在政治或科学领域存在争议，课堂上也应呈现关于它的不同立场。",
      "glosses": [
        {
          "surface": "Wissenschaft",
          "lemma": "die Wissenschaft",
          "zh": "科学；学术"
        },
        {
          "surface": "verschiedene",
          "lemma": "verschieden",
          "zh": "不同的"
        },
        {
          "surface": "Positionen",
          "lemma": "die Position",
          "zh": "立场",
          "note": "复数"
        },
        {
          "surface": "umstritten",
          "lemma": "umstritten",
          "zh": "有争议的"
        },
        {
          "surface": "vorkommen",
          "lemma": "vorkommen",
          "zh": "出现；被呈现"
        }
      ]
    },
    {
      "id": "s8",
      "text": "Die Lernenden sollen eine eigene politische Meinung entwickeln.",
      "zh": "学习者应当形成自己的政治观点。",
      "glosses": [
        {
          "surface": "Lernenden",
          "lemma": "der/die Lernende",
          "zh": "学习者",
          "note": "名词化分词，复数形式 die Lernenden"
        },
        {
          "surface": "sollen",
          "lemma": "sollen",
          "zh": "应当",
          "note": "这里表达教育目标"
        },
        {
          "surface": "entwickeln",
          "lemma": "entwickeln",
          "zh": "形成；发展"
        }
      ]
    },
    {
      "id": "s9",
      "text": "Sie sollen ihre Interessen selbstständig vertreten können.",
      "zh": "他们应当能够独立表达并维护自己的利益诉求。",
      "glosses": [
        {
          "surface": "Interessen",
          "lemma": "das Interesse",
          "zh": "利益；诉求",
          "note": "此处不是兴趣爱好"
        },
        {
          "surface": "selbstständig",
          "lemma": "selbstständig",
          "zh": "独立地"
        },
        {
          "surface": "vertreten",
          "lemma": "vertreten",
          "zh": "表达并维护",
          "note": "Interessen vertreten：维护利益、表达诉求"
        }
      ]
    },
    {
      "id": "s10",
      "text": "Lehrkräfte dürfen sich auch gegen menschenfeindliche Positionen aussprechen.",
      "zh": "教师也可以表态反对仇视他人的立场。",
      "glosses": [
        {
          "surface": "Lehrkräfte",
          "lemma": "die Lehrkraft",
          "zh": "教师",
          "note": "复数，不限定性别的职业称谓"
        },
        {
          "surface": "menschenfeindliche",
          "lemma": "menschenfeindlich",
          "zh": "仇视他人的"
        },
        {
          "surface": "aussprechen",
          "lemma": "sich aussprechen",
          "zh": "表态",
          "note": "sich gegen etwas aussprechen：表态反对某事"
        }
      ]
    }
